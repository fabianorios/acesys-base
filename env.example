# Cursor cloud credential (required for model turns). Keep on the client machine only.
CURSOR_API_KEY=

# Local / LAN Firebird — never commit real values; password stays client-local.
ACESYS_FB_HOST=127.0.0.1
ACESYS_FB_PORT=3050
ACESYS_FB_DATABASE=C:\caminho\para\acesys.fdb
ACESYS_FB_USER=SYSDBA
ACESYS_FB_PASSWORD=

# Optional: Windows account that runs the NSSM service (prefer interactive logon user).
# Local System cannot use agent-sdk login profile credentials; use CURSOR_API_KEY above
# and/or set ObjectName to this user during install.bat.
# ACESYS_SERVICE_USER=DOMINIO\usuario
# ACESYS_SERVICE_PASSWORD=

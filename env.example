# v2 (Contabo): host stays 127.0.0.1 on the VPS; port is the tunnel listen (e.g. 13050).
# Prefer a SELECT-only Firebird user — not SYSDBA. Secrets live only on the VPS.
# Client: ops/tunnel/open-tunnel.bat → VPS 127.0.0.1:13050 → client Firebird :3050
ACESYS_FB_HOST=127.0.0.1
ACESYS_FB_PORT=13050
ACESYS_FB_DATABASE=C:\Clientes AHR\Acesys\BD\Modelo.FDB
ACESYS_FB_USER=acesys_ro
ACESYS_FB_PASSWORD=

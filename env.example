# Names only — real values go into the DPAPI vault (never commit secrets).
# Bootstrap (as the Windows user that will run the service):
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts\vault.ps1 -Action Bootstrap -FromEnvFile
#
# Vault file (default): %ProgramData%\AcesysBase\secrets.dpapi
# Contents (encrypted): CURSOR_API_KEY, ACESYS_FB_*, PLAYGROUND_PASSWORD_HASH,
#                       SESSION_SECRET, AGENT_BEARER_TOKEN
#
# Optional leftovers in .env after bootstrap (service ObjectName only):
# ACESYS_SERVICE_USER=DOMINIO\usuario
# ACESYS_SERVICE_PASSWORD=

# --- do not put secrets below in production; use vault.ps1 Bootstrap ---
# CURSOR_API_KEY=
# ACESYS_FB_HOST=127.0.0.1
# ACESYS_FB_PORT=3050
# ACESYS_FB_DATABASE=C:\caminho\para\acesys.fdb
# ACESYS_FB_USER=SYSDBA
# ACESYS_FB_PASSWORD=

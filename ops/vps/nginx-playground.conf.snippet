# Acesys v2 — sketch: protect playground/MCP on Contabo (no real secrets).
# Prefer: bind agent to 127.0.0.1 and terminate TLS + auth here, or VPN-only.
# Do not expose unauthenticated playground on 0.0.0.0.

# server {
#   listen 443 ssl http2;
